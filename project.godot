; Engine configuration file.
; LIGHT OF KIRANA — starter Godot 4.4 Android.

config_version=5

[application]

config/name="Light of Kirana"
config/description="Light of Kirana is an open-world adventure set in a vast kingdom where the light is slowly fading. As Kirana, a young wanderer carrying the last spark of light, you explore forests, mountains, and ancient ruins — climb anything, swim across rivers, solve shrines, and battle creatures of darkness to bring the light back to the world."
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
