; Engine configuration file.
; LIGHT OF KIRANA — starter Godot 4.7 Android.

config_version=5

[application]

config/name="Light of Kirana"
config/description="Light of Kirana is an open-world adventure set in a vast kingdom where the light is slowly fading. As Kirana, a young wanderer carrying the last spark of light, you explore forests, mountains, and ancient ruins — climb anything, swim across rivers, solve shrines, and battle creatures of darkness to bring the light back to the world."
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[input_devices]

pointing/emulate_touch_from_mouse=false
# emulate_mouse_from_touch DIMATIKAN (bukan default true): emulasi
# mouse dari sentuhan itu SATU pointer saja — sentuhan pertama yang
# jadi mouse, sentuhan berikutnya tidak menghasilkan event mouse,
# jadi tombol/kamera mati kalau analog disentuh duluan (bug multi-touch
# hero-game 2026-11-08). Semua kontrol menangani InputEventScreenTouch
# langsung (joystick, tombol via gui_input, kamera via _unhandled_input);
# Button tetap merespons mouse asli di desktop. JANGAN nyalakan lagi
# tanpa mengembalikan handler sentuhan native-nya.

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
