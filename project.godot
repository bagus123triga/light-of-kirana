; Engine configuration file.
; LIGHT OF KIRANA — procedural walking experiment (Godot 4.4).
; Reference: Procedural Humanoid Locomotion — Benjamin J Singer
; https://procedural-humanoid.benjaminjsinger.com/
; Architecture: step planner -> spring-damped body -> two-bone IK.
; No animation clips, no mocap. World: flat grey map, daylight, orange humanoid.

config_version=5

[application]

config/name="Light of Kirana"
config/description="Light of Kirana — third-person movement prototype with a rigged humanoid and CC0 animation clips."
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
